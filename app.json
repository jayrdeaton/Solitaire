{
  "expo": {
    "name": "Solitaire",
    "slug": "Solitaire",
    "scheme": "solitaire",
    "version": "1.2.0",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "orientation": "portrait",
    "icon": "./assets/images/icon-dark.png",
    "userInterfaceStyle": "automatic",
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.infinitetoken.solitaire",
      "icon": {
        "dark": "./assets/images/icon-dark.png",
        "light": "./assets/images/icon-light.png"
      },
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.infinitetoken.tastic"
        ]
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.infinitetoken.solitaire",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/images/splash-dark.png",
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-light.png",
          "imageWidth": 200,
          "backgroundColor": "#FAFAFA",
          "dark": {
            "image": "./assets/images/splash-dark.png",
            "backgroundColor": "#050505"
          }
        }
      ],
      "expo-font",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ],
      "expo-asset",
      "@tastic/core"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "59f46134-8691-4d34-bfd7-8f565f824b00"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/59f46134-8691-4d34-bfd7-8f565f824b00"
    },
    "owner": "jayrdeaton"
  }
}
