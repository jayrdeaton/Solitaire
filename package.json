{
  "name": "solitaire-app",
  "version": "1.0.0",
  "private": true,
  "description": "An ad-free, self-contained solitaire suite (Klondike, Spider, FreeCell, Pyramid) built with Expo.",
  "type": "commonjs",
  "main": "expo-router/entry",
  "scripts": {
    "android": "expo run:android",
    "build": "rific-updater-build",
    "client": "expo start --dev-client",
    "doctor": "expo install --fix && npx expo-doctor@latest",
    "fingerprint:compare": "eas fingerprint:compare",
    "fix": "expo lint . --fix",
    "postinstall": "setup-skia-web",
    "ios": "expo run:ios",
    "lint": "expo lint .",
    "reset": "expo start -c",
    "run": "eas build:run",
    "start": "expo start",
    "submit": "eas submit",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "update": "rific-updater-update",
    "verify": "npm run lint && npm test && npm run typecheck",
    "web": "expo start --web"
  },
  "prettier": "@infinitetoken/eslint-config/prettier",
  "dependencies": {
    "@expo/log-box": "^57.0.1",
    "@expo/metro-runtime": "~57.0.15",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@rific/auto-paper": "^0.10.3",
    "@rific/feedback-press": "^0.10.9",
    "@rific/focus-chain": "^0.4.7",
    "@rific/splash-gate": "^0.2.2",
    "@rific/toaster": "^0.6.3",
    "@rific/updater": "^0.6.0",
    "@shopify/react-native-skia": "2.6.2",
    "@tastic/achievements": "^0.1.1",
    "@tastic/animations": "^0.1.1",
    "@tastic/cards": "^0.2.0",
    "@tastic/core": "^0.4.1",
    "@tastic/hud": "^0.8.2",
    "@tastic/profile": "^0.3.8",
    "dejavu-fonts-ttf": "^2.37.3",
    "expo": "~57.0.21",
    "expo-asset": "~57.0.16",
    "expo-audio": "~57.0.4",
    "expo-constants": "^57.0.7",
    "expo-dev-client": "~57.0.18",
    "expo-font": "~57.0.3",
    "expo-haptics": "~57.0.2",
    "expo-linking": "~57.0.9",
    "expo-router": "~57.0.20",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-updates": "~57.0.21",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-paper": "^5.15.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@infinitetoken/eslint-config": "^0.2.0",
    "@infinitetoken/jest-config": "^0.3.0",
    "@infinitetoken/tsconfig": "^0.4.1",
    "@react-native/jest-preset": "^0.86.0",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "babel-preset-expo": "^57.0.4",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react-native": "^5.0.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "prettier": "^3.9.6",
    "svgson": "^5.3.1",
    "test-renderer": "^1.2.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.65.0"
  }
}
