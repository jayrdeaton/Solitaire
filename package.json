{
  "name": "solitaire-app",
  "version": "1.2.3",
  "private": true,
  "description": "Eleven classic solitaire games in one app (Klondike, Spider, FreeCell, Pyramid and more), ad-free, built with Expo.",
  "type": "commonjs",
  "main": "expo-router/entry",
  "scripts": {
    "android": "expo run:android",
    "build": "eas build",
    "build:web": "npm run verify && WEB_BASE_URL=/solitaire expo export -p web --output-dir web-build/solitaire",
    "client": "expo start --dev-client",
    "doctor": "expo install --fix && npx expo-doctor@latest",
    "fingerprint:compare": "eas fingerprint:compare",
    "fix": "expo lint . --fix",
    "ios": "expo run:ios",
    "lint": "expo lint .",
    "par": "node scripts/simulate-par.mjs",
    "reset": "expo start -c",
    "run": "eas build:run",
    "start": "expo start",
    "submit": "eas submit",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "update": "eas update",
    "verify": "npm run lint && npm test && npm run typecheck",
    "web": "expo start --web"
  },
  "prettier": "@infinitetoken/eslint-config/prettier",
  "dependencies": {
    "@expo/log-box": "^57.0.1",
    "@expo/metro-runtime": "~58.0.14",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-masked-view/masked-view": "0.3.2",
    "@reduxjs/toolkit": "^2.12.0",
    "@rific/auto-paper": "^0.13.3",
    "@rific/core": "^0.5.0",
    "@rific/feedback-press": "^0.13.1",
    "@rific/focus-chain": "^0.4.8",
    "@rific/splash-gate": "^0.2.3",
    "@rific/toaster": "^0.9.0",
    "@rific/updater": "^0.7.1",
    "@tastic/achievements": "^0.6.0",
    "@tastic/cards": "^0.6.0",
    "@tastic/core": "^0.14.0",
    "@tastic/hud": "^0.24.1",
    "@tastic/profile": "^0.16.2",
    "dejavu-fonts-ttf": "^2.37.3",
    "expo": "~58.0.14",
    "expo-asset": "~58.0.16",
    "expo-audio": "~58.0.9",
    "expo-blur": "~58.0.4",
    "expo-constants": "~58.0.12",
    "expo-dev-client": "~58.0.14",
    "expo-font": "~58.0.8",
    "expo-haptics": "~58.0.7",
    "expo-keep-awake": "~58.0.3",
    "expo-linking": "~58.0.13",
    "expo-router": "~58.0.23",
    "expo-sensors": "~58.0.4",
    "expo-splash-screen": "~58.0.10",
    "expo-system-ui": "~58.0.6",
    "expo-updates": "~58.0.17",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-paper": "^5.15.3",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.13.0",
    "react-redux": "^9.3.0",
    "redux-persist": "^6.0.0"
  },
  "devDependencies": {
    "@infinitetoken/eslint-config": "^0.2.1",
    "@infinitetoken/jest-config": "^0.5.2",
    "@infinitetoken/tsconfig": "^0.6.0",
    "@react-native/jest-preset": "^0.88.0",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "babel-preset-expo": "~58.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react-native": "^5.0.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.11",
    "prettier": "^3.9.6",
    "test-renderer": "^1.2.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.65.0",
    "upng-js": "^2.1.0"
  },
  "reanimated": {
    "staticFeatureFlags": {
      "IOS_SYNCHRONOUSLY_UPDATE_UI_PROPS": true
    }
  }
}
