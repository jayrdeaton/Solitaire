{
  "extends": "@infinitetoken/tsconfig/expo",
  "compilerOptions": {
    "paths": {
      "@/*": [
        "./*"
      ],
      "@/app/*": [
        "./src/app/*"
      ],
      "@/components/*": [
        "./src/components/*"
      ],
      "@/constants/*": [
        "./src/constants/*"
      ],
      "@/engine/*": [
        "./src/engine/*"
      ],
      "@/games/*": [
        "./src/games/*"
      ],
      "@/hooks/*": [
        "./src/hooks/*"
      ],
      "@/redux/*": [
        "./src/redux/*"
      ],
      "@/stores/*": [
        "./src/stores/*"
      ],
      "@/types": [
        "./src/types"
      ],
      "@/utils/*": [
        "./src/utils/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
